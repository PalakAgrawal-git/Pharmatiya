# Pharmatiya Health — environment variables.
#
# Copy to .env.local for local work. On Vercel these go in
# Settings → Environment Variables, and a change only takes effect on the
# next deployment: every one of these is read at build time or on the
# server, never from the visitor's browser.
#
# .env.local is gitignored. Never commit a real key.
#
# ONE RULE ABOVE ALL: anything named NEXT_PUBLIC_* is compiled into the
# JavaScript every visitor downloads. It is public. An API key must never
# carry that prefix.


# ── The drafting service (app/api/synopsis) ─────────────────────────────
# Secret. Server only. Without this the route returns 503 and the synopsis
# builder keeps drafting in the browser, which is how the site runs today.

# Required to connect the model. From platform.openai.com → API keys.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini, the cheapest model able to do this job.
OPENAI_MODEL=

# Optional. Only for an OpenAI-compatible provider that is not OpenAI.
OPENAI_BASE_URL=

# Optional. Ceiling on the length of one synopsis, and so on its cost. Must
# clear a full draft: a reply cut off at the limit is unparseable JSON, not
# a shorter document.
# Defaults to 4000.
SYNOPSIS_MAX_TOKENS=


# ── Build ───────────────────────────────────────────────────────────────

# Set to 1 to build with a server, so the drafting service exists at all.
# Unset, the site is a static export and the route is not deployed.
SERVER_BUILD=

# Public. The address the builder posts to. Set to /api/synopsis/ to use the
# route above; leave empty to draft in the browser. Setting this also
# changes what the page says about where a question goes, so do not set it
# until the key is in place.
#
# Keep the trailing slash. The site is built with trailingSlash: true, so
# /api/synopsis answers with a redirect and every request pays for two.
NEXT_PUBLIC_SYNOPSIS_API=


# ── Contact form ────────────────────────────────────────────────────────

# Public. The Google Apps Script /exec URL. See docs/enquiries.gs.
NEXT_PUBLIC_FORM_ENDPOINT=


# ── Hosting ─────────────────────────────────────────────────────────────

# Public. Only for a host that serves the site from a subdirectory, such as
# a GitHub Pages project site. Leave empty on Vercel and on the live domain.
NEXT_PUBLIC_BASE_PATH=

# Public. Keeps the site out of search results before launch.
NEXT_PUBLIC_PREVIEW=
